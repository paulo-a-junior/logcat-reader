# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Test coverage
/coverage/

# Local release packaging (see .github/workflows/release.yml)
/dist/
/logcat_reader-*.tar.gz
/logcat_reader-*.zip
SHA256SUMS.txt

# Flutter version managers
.fvm/flutter_sdk
.fvmrc.local

# Secrets and local environment — never commit these
.env
.env.*
*.pem
*.p12
*.mobileprovision
**/*.keystore
**/*.jks

# Notes:
# - pubspec.lock IS committed (this is an application, not a package).
# - lib/l10n/gen/ IS committed: it is generated by `flutter gen-l10n`, which
#   `flutter pub get` does not run (synthetic-package: false), and CI runs
#   `flutter analyze` before building.
# - Platform folders (linux/, macos/, windows/, android/, ios/, web/) have
#   their own .gitignore files for their ephemeral build state.
